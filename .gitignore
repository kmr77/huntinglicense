# 基本的にすべて無視
/*

# .gitignore 自体は追跡
!/.gitignore

# Codex管理用Markdownのみ追跡対象にする
!/_codex/
/_codex/*
!/_codex/SITE-STRUCTURE.md
!/_codex/TODO.md
!/_codex/CHANGELOG.md
!/_codex/DECISIONS.md
!/_codex/logs/
/_codex/logs/*
!/_codex/logs/*.md

# 対象テーマまでのディレクトリだけ通す
!/wp-content/
#/wp-content 以下は一旦すべて無視
/wp-content/*

!/wp-content/themes/
/wp-content/themes/*

# hunting-licence テーマだけ追跡
!/wp-content/themes/hunting-licence/
!/wp-content/themes/hunting-licence/**
